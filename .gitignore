# ignore the user configuration file
conf.yaml

# pre-streaming frontend backup (local safety copy, not for VCS)
frontend_backup_prestreaming/

# ignore non-default background images
/backgrounds/*
!/backgrounds/README.md

# ignore non-default live2d models
/live2d-models/*
!/live2d-models/mao_pro
!/live2d-models/shizuku

# ignore non-default character configs
/characters/*
!/characters/README.md
# but all of the defaults are already tracked, so no need to un-ignore them

# ignore avatars
avatars/*

# macOS system files
.DS_Store

# Python files
__pycache__/
*.pyc
lab.py
.idea

# Virtual environment
.venv
.conda
conda

# Local conda/miniconda environment (must never be committed)
third_party/miniconda3/

# PC-B brain switch (./kehai.sh mode): per-box state, never shared
.mode
.render-display
.mode-stage

# Sensitive data
.env
.motion_gateway_key
api_keys.py
src/kehai/llm/user_credentials.json

# Database files
memory.db
memory.db.bk

# Logs
server.log
server.stdout.log
server.stderr.log
logs/*

# Cache and models
cache/*
src/kehai/tts/asset
src/kehai/tts/config
src/kehai/asr/models*
!src/kehai/asr/models/silero_vad.onnx
asset
models/*
!models/piper_voice
models/piper_voice/*


