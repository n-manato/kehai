legacy/
chat_history/
knowledge_base/
submodules/MeloTTS
openapi_assistants.json
openapi_memgpt.json

# memory log
mem.json
conf.yaml.backup

*.exe

tmp/
private/
mcp_servers.json

.vscode/
# --- Live2D / TTS 作業で出た一時ファイル（コミット不要）---
*.bak
*.bak2
**/_act_backup/
tts_voice_samples/

# --- frontend を本体取り込み後、ビルド成果物/依存は除外 ---
frontend/node_modules/
frontend/dist/

# --- HY-Motion ライブ生成サービス (PC-B) ---
# モデル重み (数GB〜十数GB) は Git に入れない。PC-B で HuggingFace から直接DL。
motion-service/ckpts/
# SMPL/SMPL-H ボディモデル (ライセンス上も再配布不可)
motion-service/body_models/
# 生成/リターゲット済みクリップのキャッシュ
motion-service/cache/
motion-service/.venv/
# PC-A 側が PC-B から取得した .vmd の配信キャッシュ
cache/motion/

# Local reference video (too large for GitHub; keep only in the working tree)
/videos/【MMD】トゥーン調エフェクトメイキング【msToonCoordinator】.mp4

# ElevenLabs API key (same convention as .motion_gateway_key)
.elevenlabs_key

# --- 2026-08-20: push 前整理 ---
# conf.yaml の作業用バックアップ。実キー (sk-proj- / lag_) が入っているので絶対に追跡しない。
# 既存の `*.bak` ルールは `conf.yaml.bak-cloud-openai` のような接尾辞つきに当たらない。
conf.yaml.bak-*
# サーバのローテートログ
server.err.log
server.err.prev*.log
server.prev*.log
# 動画フレーム抽出の一時出力
tmp_vidframes/
tmp_vidframes2/
# ASR 手動検証の残骸
_asr_payload.json
_asr_test.wav
# Playwright の実行結果
frontend-src/test-results/
# 他エージェントのローカル設定
.cursor/
.gemini/
certs/

# exhibition mic calibration (render_view mic panel)
mic_tuning.json
mic_tuning.tmp

# kehai-glgrab is built by scripts/pcb-render-x/glgrab/build.sh (start_server.sh runs it when missing)
scripts/pcb-render-x/glgrab/kehai-glgrab

